# Grafana connection settings
# URL of your Grafana instance
GRAFANA_URL=http://localhost:3000

# API key (Bearer token) for authentication. Used when GRAFANA_USER is not set.
GRAFANA_API_KEY=your_grafana_api_key_here

# Username for basic auth. When both GRAFANA_USER and GRAFANA_PASSWORD are set,
# basic auth is used instead of the API key. Required for multi-org support.
GRAFANA_USER=
GRAFANA_PASSWORD=

# Skip TLS certificate verification (set to true for self-signed certificates)
SKIP_TLS_VERIFY=true

# Grafana version (used for API compatibility, e.g. nested folders support)
GRAFANA_VERSION=11.1

# Directory where exported dashboards will be saved (absolute or relative path)
EXPORT_DIRECTORY=./exported

# Server settings
# Host and port the exporter web UI listens on
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# UI settings
# Force the "Export as ZIP" checkbox to be always enabled and checked
FORCE_ENABLE_ZIP_EXPORT=false
